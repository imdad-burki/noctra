<?xml version="1.0" encoding="utf-8"?>
<!--
  API 27+ theme overrides. android:windowLightNavigationBar requires API 27
  (minSdk is 26), so it lives here — the base theme in values/themes.xml
  stays API-26-safe. Same theme name + items, plus the 27+ attribute.
-->
<resources>
    <style name="Theme.Noctra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/noctra_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/noctra_bg</item>
        <item name="android:navigationBarColor">@color/noctra_bg</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
